# Backend API process (used only with real API mode)
PORT=3000
ADMIN_EMAIL=
ADMIN_PASSWORD=
FRONTEND_ORIGIN=https://trinetrarealtyy.netlify.app
# MongoDB Connection String (e.g. mongodb://127.0.0.1:27017/trinetra_realty or MongoDB Atlas connection URI)
MONGODB_URI=mongodb://127.0.0.1:27017/trinetra_realty

# =============================================================================
# BUSINESS OWNER NOTIFICATIONS (Email + WhatsApp)
# =============================================================================
# Business Owner Recipients
OWNER_NOTIFICATION_EMAIL=admin@trinetrarealty.com
OWNER_WHATSAPP_NUMBER=+919876543210

# Email Delivery (SMTP: Gmail, Brevo, SendGrid, Amazon SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Trinetra Realty CRM" <notifications@trinetrarealty.com>



# Frontend build/development. Public values only: Vite embeds VITE_ variables.
# Temporary client demo: true = browser-only demo; false/missing = real API.
VITE_DEMO_MODE=false
VITE_API_BASE_URL=
VITE_API_PROXY=http://localhost:3000
