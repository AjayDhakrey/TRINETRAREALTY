{
    "name":  "trinetra-realty-platform",
    "private":  true,
    "version":  "0.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "node ./node_modules/vite/bin/vite.js frontend --config frontend/vite.config.ts",
                    "start":  "npm run dev:api",
                    "build":  "node ./node_modules/vite/bin/vite.js build frontend --config frontend/vite.config.ts",
                    "preview":  "node ./node_modules/vite/bin/vite.js preview frontend --config frontend/vite.config.ts",
                    "clean":  "node -e \"require(\u0027node:fs\u0027).rmSync(\u0027frontend/dist\u0027,{recursive:true,force:true})\"",
                    "lint":  "node ./node_modules/typescript/bin/tsc --noEmit -p frontend/tsconfig.json",
                    "dev:api":  "node ./node_modules/tsx/dist/cli.mjs backend/server.ts",
                    "typecheck:backend":  "node ./node_modules/typescript/bin/tsc --noEmit --module ESNext --moduleResolution bundler --target ES2022 --types node --skipLibCheck backend/server.ts"
                },
    "dependencies":  {
                         "@google/genai":  "^2.4.0",
                         "@tailwindcss/vite":  "^4.3.3",
                         "@vitejs/plugin-react":  "^6.1.1",
                         "lucide-react":  "^0.546.0",
                         "react":  "^19.0.1",
                         "react-dom":  "^19.0.1",
                         "vite":  "^8.3.0",
                         "express":  "^4.21.2",
                         "dotenv":  "^17.2.3",
                         "motion":  "^12.23.24"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.14.0",
                            "@types/react":  "^19.3.0",
                            "@types/react-dom":  "^19.3.0",
                            "autoprefixer":  "^10.4.21",
                            "esbuild":  "^0.28.0",
                            "tailwindcss":  "^4.3.3",
                            "tsx":  "^4.21.0",
                            "typescript":  "^7.0.2",
                            "@types/express":  "^4.17.21"
                        }
}
