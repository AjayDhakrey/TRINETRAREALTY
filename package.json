{
    "name": "trinetra-realty-platform",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev.js",
        "dev:frontend": "node ./node_modules/vite/bin/vite.js frontend --config frontend/vite.config.ts",
        "start": "npm run dev:api",
        "build": "node ./node_modules/vite/bin/vite.js build frontend --config frontend/vite.config.ts",
        "preview": "node ./node_modules/vite/bin/vite.js preview frontend --config frontend/vite.config.ts",
        "clean": "node -e \"require('node:fs').rmSync('frontend/dist',{recursive:true,force:true})\"",
        "lint": "node ./node_modules/typescript/bin/tsc --noEmit -p frontend/tsconfig.json",
        "dev:api": "node ./node_modules/tsx/dist/cli.mjs backend/server.ts",
        "typecheck:backend": "node ./node_modules/typescript/bin/tsc --noEmit --module ESNext --moduleResolution bundler --target ES2022 --types node --skipLibCheck backend/server.ts",
        "test:backend": "node scripts/test-backend.mjs",
        "test:mongo": "node ./node_modules/tsx/dist/cli.mjs scripts/test-mongo.mjs"
    },
    "dependencies": {
        "@google/genai": "^2.4.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/qrcode": "^1.5.6",
        "@vitejs/plugin-react": "^6.1.1",
        "@whiskeysockets/baileys": "^6.7.24",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "lucide-react": "^0.546.0",
        "mongoose": "^9.11.0",
        "motion": "^12.23.24",
        "nodemailer": "^10.0.16",
        "pino": "^10.4.0",
        "qrcode": "^1.5.4",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "vite": "^8.3.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.14.0",
        "@types/nodemailer": "^8.0.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "autoprefixer": "^10.4.21",
        "esbuild": "^0.28.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.21.0",
        "typescript": "^7.0.2"
    }
}
